# LifeGoods PRODUCTION secrets (gitignored). Copy to infra/secrets/prod/.env and
# fill with strong random values before deploying. Never commit this file.
#
# Generate with:  openssl rand -hex 24   (or python -c "import secrets;print(secrets.token_urlsafe(32))")

# --- MongoDB (OFF dataset) ---
LIFEGOODS_OFF_DATABASE=lifegoods_off
LIFEGOODS_MONGO_ROOT_USER=lifegoods_root
LIFEGOODS_MONGO_ROOT_PASSWORD=CHANGE_ME_STRONG_MONGO_ROOT_PASSWORD
LIFEGOODS_OFF_READER_USER=lifegoods_reader
LIFEGOODS_OFF_READER_PASSWORD=CHANGE_ME_STRONG_MONGO_READER_PASSWORD
LIFEGOODS_OFF_WRITER_USER=lifegoods_writer
LIFEGOODS_OFF_WRITER_PASSWORD=CHANGE_ME_STRONG_MONGO_WRITER_PASSWORD

# --- Isolated generated translation storage ---
LIFEGOODS_GENERATED_DATABASE=lifegoods_generated
LIFEGOODS_GENERATED_USER=lifegoods_generated
LIFEGOODS_GENERATED_PASSWORD=CHANGE_ME_STRONG_GENERATED_PASSWORD
# Leave empty to disable generation; Original Text remains available.
LIFEGOODS_GEMINI_API_KEY=

# --- Redis ---
LIFEGOODS_REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

# --- App ---
# JSON-encoded array of origins allowed to call the API. In prod this is your
# public HTTPS origin only. MUST NOT be "*".
LIFEGOODS_ALLOWED_ORIGINS='["https://app.example.com"]'
# JSON-encoded array containing the Docker network CIDR used by Nginx, for
# example '["172.20.0.0/16"]'. Set this to the actual deployment network.
LIFEGOODS_TRUSTED_PROXY_CIDRS='[]'

# OpenFoodFacts image base URL (for the image caching proxy).
LIFEGOODS_OPEN_FOOD_FACTS_IMAGE_BASE_URL=https://images.openfoodfacts.org
