# LifeGoods STAGING secrets (gitignored). Copy to infra/secrets/staging/.env and
# fill with strong random values -- DIFFERENT from production. Never commit.

# --- MongoDB (OFF dataset) ---
LIFEGOODS_OFF_DATABASE=lifegoods_off_staging
LIFEGOODS_MONGO_ROOT_USER=lifegoods_root
LIFEGOODS_MONGO_ROOT_PASSWORD=CHANGE_ME_STRONG_STAGING_MONGO_ROOT_PASSWORD
LIFEGOODS_OFF_READER_USER=lifegoods_reader
LIFEGOODS_OFF_READER_PASSWORD=CHANGE_ME_STRONG_STAGING_MONGO_READER_PASSWORD
LIFEGOODS_OFF_WRITER_USER=lifegoods_writer
LIFEGOODS_OFF_WRITER_PASSWORD=CHANGE_ME_STRONG_STAGING_MONGO_WRITER_PASSWORD

# --- Isolated generated translation storage ---
LIFEGOODS_GENERATED_DATABASE=lifegoods_generated_staging
LIFEGOODS_GENERATED_USER=lifegoods_generated
LIFEGOODS_GENERATED_PASSWORD=CHANGE_ME_STRONG_GENERATED_PASSWORD
# Leave empty to disable generation; Original Text remains available.
LIFEGOODS_GEMINI_API_KEY=

# --- Redis ---
LIFEGOODS_REDIS_PASSWORD=CHANGE_ME_STRONG_STAGING_REDIS_PASSWORD

# --- App ---
LIFEGOODS_ALLOWED_ORIGINS='["https://staging.example.com"]'
LIFEGOODS_OPEN_FOOD_FACTS_IMAGE_BASE_URL=https://images.openfoodfacts.org
