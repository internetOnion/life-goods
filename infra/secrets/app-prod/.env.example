# Production. Copy to .env, chmod 600, and fill privately on the VPS (docs/production-deployment.md).
# Never reuse staging or localhost credentials.
LIFEGOODS_BACKEND_IMAGE=ghcr.io/internetonion/life-goods-backend:REPLACE_COMMIT_SHA
LIFEGOODS_CLOUDFLARED_IMAGE=cloudflare/cloudflared:REPLACE_PINNED_VERSION
LIFEGOODS_DATASET_NETWORK=compose_default
# Production reader identity: only `read` on the shared lifegoods_off database.
LIFEGOODS_OFF_MONGODB_URI=mongodb://PROD_READER:URL_ENCODED_PASSWORD@mongodb:27017/lifegoods_off?authSource=lifegoods_off
LIFEGOODS_OFF_MONGODB_DATABASE=lifegoods_off
# Production generated data is isolated from staging: its own database and identity.
LIFEGOODS_GENERATED_MONGODB_URI=mongodb://PROD_GENERATED:URL_ENCODED_PASSWORD@mongodb:27017/lifegoods_generated_prod?authSource=lifegoods_generated_prod
LIFEGOODS_GENERATED_MONGODB_DATABASE=lifegoods_generated_prod
LIFEGOODS_REDIS_PASSWORD=REPLACE_RANDOM_PASSWORD
LIFEGOODS_REDIS_URL=redis://:REPLACE_SAME_URL_ENCODED_PASSWORD@redis:6379/0
LIFEGOODS_ALLOWED_ORIGINS=["https://lifegoods.REPLACE_SUBDOMAIN.workers.dev"]
# A separate production key with provider-side quotas and a budget alert. Leave empty until they exist.
LIFEGOODS_GEMINI_API_KEY=
# Admission limits (not a spending cap). Defaults in the compose file: 10 and 3.
# LIFEGOODS_GENERATED_TRANSLATION_BUDGET_PER_MINUTE=10
# LIFEGOODS_PHOTO_COMPARISON_REQUESTS_PER_MINUTE=3
