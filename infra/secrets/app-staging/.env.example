# Copy to .env, restrict permissions, and fill after read-only VPS inspection.
LIFEGOODS_BACKEND_IMAGE=ghcr.io/internetonion/life-goods-backend:REPLACE_COMMIT_SHA
LIFEGOODS_CLOUDFLARED_IMAGE=cloudflare/cloudflared:REPLACE_PINNED_VERSION
LIFEGOODS_DATASET_NETWORK=compose_default
LIFEGOODS_OFF_MONGODB_URI=mongodb://READER:URL_ENCODED_PASSWORD@mongodb:27017/lifegoods_off?authSource=lifegoods_off
LIFEGOODS_OFF_MONGODB_DATABASE=lifegoods_off
LIFEGOODS_GENERATED_MONGODB_URI=mongodb://GENERATED:URL_ENCODED_PASSWORD@mongodb:27017/lifegoods_generated?authSource=lifegoods_generated
LIFEGOODS_GENERATED_MONGODB_DATABASE=lifegoods_generated
LIFEGOODS_REDIS_PASSWORD=REPLACE_RANDOM_PASSWORD
LIFEGOODS_REDIS_URL=redis://:REPLACE_SAME_URL_ENCODED_PASSWORD@redis:6379/0
LIFEGOODS_ALLOWED_ORIGINS=["https://lifegoods-staging.REPLACE_SUBDOMAIN.workers.dev"]
# Leave empty until provider-side quotas are configured.
LIFEGOODS_GEMINI_API_KEY=
