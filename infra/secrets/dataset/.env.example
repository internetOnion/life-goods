# Copy to infra/secrets/dataset/.env and keep the copy out of version control.
# Use long, unique values. Do not reuse development credentials.

LIFEGOODS_MONGO_ROOT_USER=lifegoods_admin
LIFEGOODS_MONGO_ROOT_PASSWORD=replace-with-a-long-random-password
LIFEGOODS_OFF_DATABASE=lifegoods_off
LIFEGOODS_OFF_READER_USER=lifegoods_reader
LIFEGOODS_OFF_READER_PASSWORD=replace-with-a-long-random-password
LIFEGOODS_OFF_WRITER_USER=lifegoods_writer
LIFEGOODS_OFF_WRITER_PASSWORD=replace-with-a-long-random-password

# Set this to the VPS Tailscale IPv4 address, for example 100.64.0.12.
# Leaving it unset binds MongoDB to localhost only.
LIFEGOODS_MONGO_BIND_IP=127.0.0.1

# Use a dedicated volume if the default VPS disk is not appropriate.
LIFEGOODS_MONGO_DATA_DIR=/srv/lifegoods/mongodb
