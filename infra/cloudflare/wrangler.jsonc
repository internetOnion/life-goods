{
    "name": "lifegoods-staging",
    "main": "worker.mjs",
    "compatibility_date": "2026-09-16",
    "workers_dev": true,
    "preview_urls": false,
    "observability": { "enabled": false },
    "assets": {
        "directory": "../../frontend/dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": [
            "/api/*",
            "/docs",
            "/docs/*",
            "/redoc",
            "/redoc/*",
            "/scalar",
            "/scalar/*",
            "/openapi.json",
        ],
    },
    "vpc_services": [
        {
            "binding": "PRIVATE_API",
            "service_id": "00000000-0000-0000-0000-000000000000",
        },
    ],
}
