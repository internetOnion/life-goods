{
    "name": "@lifegoods/web-client",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "predev": "node scripts/generate-dev-cert.mjs --force",
        "dev": "vite --mode https",
        "dev:http": "vite --mode http",
        "predev:https": "node scripts/generate-dev-cert.mjs --force",
        "dev:https": "vite --mode https",
        "build": "tsc -b && vite build",
        "typecheck": "tsc -b --pretty false",
        "lint": "pnpm check:styling && eslint .",
        "check:styling": "node scripts/check-styling.mjs",
        "lint:check": "prettier --check . && eslint .",
        "lint:format": "prettier --write .",
        "test": "vitest run",
        "api:generate": "openapi-ts -i openapi.json -o src/api/generated"
    },
    "dependencies": {
        "@phosphor-icons/react": "^2.1.10",
        "@radix-ui/react-label": "^2.1.15",
        "@radix-ui/react-slot": "^1.3.3",
        "@tanstack/react-query": "^5.85.5",
        "@zxing/browser": "0.2.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "i18next": "^25.4.2",
        "react": "^19.1.1",
        "react-dom": "^19.1.1",
        "react-i18next": "^15.7.3",
        "react-router": "^7.8.2",
        "tailwind-merge": "^3.6.0",
        "tw-animate-css": "^1.4.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.34.0",
        "@hey-api/openapi-ts": "^0.84.1",
        "@tailwindcss/vite": "^4.1.12",
        "@testing-library/jest-dom": "^6.8.0",
        "@testing-library/react": "^16.3.0",
        "@testing-library/user-event": "^14.6.1",
        "@types/node": "^24.3.0",
        "@types/react": "^19.1.12",
        "@types/react-dom": "^19.1.9",
        "@vitejs/plugin-react": "^5.0.2",
        "eslint": "^9.34.0",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-react-refresh": "^0.4.20",
        "globals": "^16.3.0",
        "jsdom": "^26.1.0",
        "tailwindcss": "^4.1.12",
        "typescript": "~5.9.2",
        "typescript-eslint": "^8.41.0",
        "vite": "^7.1.3",
        "vitest": "^3.2.4"
    }
}
