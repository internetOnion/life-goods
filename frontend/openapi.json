{
  "components": {
    "schemas": {
      "ErrorCode": {
        "enum": [
          "IDENTIFIER_REQUIRED",
          "IDENTIFIER_CHARACTERS_INVALID",
          "IDENTIFIER_LENGTH_UNSUPPORTED",
          "IDENTIFIER_CHECK_DIGIT_INVALID",
          "PACKAGE_MATCH_SOURCE_UNAVAILABLE"
        ],
        "title": "ErrorCode",
        "type": "string"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorEnvelope": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorEnvelope",
        "type": "object"
      },
      "IdentifierScheme": {
        "enum": [
          "GTIN_8",
          "UPC_A",
          "EAN_13",
          "GTIN_14"
        ],
        "title": "IdentifierScheme",
        "type": "string"
      },
      "PackageMatchCandidateResponse": {
        "properties": {
          "package_variant_id": {
            "title": "Package Variant Id",
            "type": "string"
          },
          "product_id": {
            "title": "Product Id",
            "type": "string"
          }
        },
        "required": [
          "package_variant_id",
          "product_id"
        ],
        "title": "PackageMatchCandidateResponse",
        "type": "object"
      },
      "PackageMatchesResponse": {
        "properties": {
          "candidates": {
            "items": {
              "$ref": "#/components/schemas/PackageMatchCandidateResponse"
            },
            "title": "Candidates",
            "type": "array"
          },
          "normalized_identifier": {
            "title": "Normalized Identifier",
            "type": "string"
          },
          "scheme": {
            "$ref": "#/components/schemas/IdentifierScheme"
          }
        },
        "required": [
          "normalized_identifier",
          "scheme",
          "candidates"
        ],
        "title": "PackageMatchesResponse",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "LifeGoods API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/package-matches": {
      "get": {
        "operationId": "getPackageMatches",
        "parameters": [
          {
            "in": "query",
            "name": "identifier",
            "required": true,
            "schema": {
              "minLength": 1,
              "title": "Identifier",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PackageMatchesResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Get Package Matches",
        "tags": [
          "Package Matches"
        ]
      }
    }
  }
}
