erDiagram
  PRODUCT ||--|{ PACKAGE_VARIANT : offers
  PACKAGE_VARIANT ||--o{ EXTERNAL_IDENTIFIER : identified_by
  PACKAGE_VARIANT ||--|{ PACKAGE_REVISION : revised_as
  PACKAGE_REVISION ||--o{ OBSERVED_PACKAGE : evidenced_by
  BATCH o|--o{ OBSERVED_PACKAGE : groups

  ORGANIZATION ||--o{ ORGANIZATION_ROLE : participates_as
  PRODUCT ||--o{ ORGANIZATION_ROLE : product_scope
  PACKAGE_VARIANT ||--o{ ORGANIZATION_ROLE : variant_scope
  PACKAGE_REVISION ||--o{ ORGANIZATION_ROLE : revision_scope
  BATCH ||--o{ ORGANIZATION_ROLE : batch_scope

  EXTERNAL_SOURCE ||--o{ EXTERNAL_SNAPSHOT : provides
  EXTERNAL_SNAPSHOT ||--|{ EVIDENCE : contains
  OBSERVED_PACKAGE ||--|{ EVIDENCE : captures
  EVIDENCE }o--o{ CLAIM : supports_or_contradicts
  PRODUCT ||--o{ CLAIM : subject
  PACKAGE_VARIANT ||--o{ CLAIM : subject
  PACKAGE_REVISION ||--o{ CLAIM : subject
  OBSERVED_PACKAGE ||--o{ CLAIM : subject
  BATCH ||--o{ CLAIM : subject
  PACKAGE_REVISION ||--o{ PREFERRED_CLAIM : selects
  CLAIM ||--o{ PREFERRED_CLAIM : preferred_as

  EXTRACTION_RUN }o--o{ EVIDENCE : reads
  EXTRACTION_RUN ||--o{ CLAIM : proposes
  ASSESSMENT_RUN }o--o{ CLAIM : evaluates
  ASSESSMENT_RUN ||--o{ DERIVED_ASSESSMENT : produces
  DERIVED_ASSESSMENT }o--o{ CLAIM : derived_from

  PRODUCT {
    uuid id PK
    datetime created_at
  }
  PACKAGE_VARIANT {
    uuid id PK
    uuid product_id FK
    string intended_market
    decimal net_quantity
    string quantity_unit
    string original_quantity_text
  }
  EXTERNAL_IDENTIFIER {
    uuid id PK
    uuid package_variant_id FK
    string scheme
    string normalized_value
    string validation_state
  }
  PACKAGE_REVISION {
    uuid id PK
    uuid package_variant_id FK
    date observed_from
    date observed_to
  }
  OBSERVED_PACKAGE {
    uuid id PK
    uuid package_revision_id FK
    uuid batch_id FK
    datetime observed_at
    string evidence_scope
  }
  BATCH {
    uuid id PK
    string lot_code
  }
  ORGANIZATION {
    uuid id PK
    string legal_name
    string country_code
  }
  ORGANIZATION_ROLE {
    uuid id PK
    uuid organization_id FK
    string role_type
    date effective_from
    date effective_to
  }
  EXTERNAL_SOURCE {
    uuid id PK
    string source_type
    string name
    string license
  }
  EXTERNAL_SNAPSHOT {
    uuid id PK
    uuid external_source_id FK
    string source_record_id
    string source_url
    datetime retrieved_at
    string source_revision
  }
  EVIDENCE {
    uuid id PK
    string evidence_type
    string storage_reference
    string language_code
    datetime observed_at
    datetime expires_at
  }
  CLAIM {
    uuid id PK
    string subject_type
    uuid subject_id
    string predicate
    json value
    string review_state
    string production_method
    decimal confidence
    datetime created_at
  }
  PREFERRED_CLAIM {
    uuid id PK
    uuid package_revision_id FK
    uuid claim_id FK
    string predicate
    datetime selected_at
    uuid selected_by FK
  }
  EXTRACTION_RUN {
    uuid id PK
    string provider
    string model
    string prompt_version
    string schema_version
    string status
    int latency_ms
  }
  ASSESSMENT_RUN {
    uuid id PK
    string vocabulary_version
    string rule_set_version
    datetime created_at
  }
  DERIVED_ASSESSMENT {
    uuid id PK
    uuid assessment_run_id FK
    string assessment_type
    string outcome
    string coverage_state
    datetime superseded_at
  }
