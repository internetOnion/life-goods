# Life Goods Backend Environment Configuration

# Open Food Facts Snapshot MongoDB (strictly read-only at runtime)
LIFEGOODS_OFF_MONGODB_URI=mongodb://lifegoods_reader:lifegoods_reader@localhost:27018/lifegoods_off
LIFEGOODS_OFF_MONGODB_DATABASE=lifegoods_off
LIFEGOODS_OFF_MONGODB_TIMEOUT_MS=2000

# Generated Data MongoDB (dedicated readWrite storage for translation artifacts)
LIFEGOODS_GENERATED_MONGODB_URI=mongodb://lifegoods_generated:lifegoods_generated@localhost:27018/lifegoods_generated
LIFEGOODS_GENERATED_MONGODB_DATABASE=lifegoods_generated
LIFEGOODS_GENERATED_MONGODB_TIMEOUT_MS=2000

# Disposable Redis Cache and Rate Limiting
LIFEGOODS_REDIS_URL=redis://localhost:6380/0
LIFEGOODS_REDIS_TIMEOUT_SECONDS=0.5

# Product Lookup
LIFEGOODS_PRODUCT_LOOKUP_CACHE_ENABLED=true
LIFEGOODS_PRODUCT_LOOKUP_CACHE_TTL_SECONDS=604800
LIFEGOODS_PRODUCT_LOOKUP_REQUESTS_PER_MINUTE=60

# Khmer Translation Persistence & Coordination
# Total translation-stage budget in seconds; must be finite and greater than zero.
# Initial default, not a measured guarantee or a total Product Lookup/network SLA.
LIFEGOODS_TRANSLATION_DEADLINE_SECONDS=12.0
LIFEGOODS_GENERATED_TRANSLATION_CACHE_TTL_SECONDS=604800
# Effective lease lifetime covers the remaining translation-stage budget plus cooldown.
LIFEGOODS_GENERATED_TRANSLATION_LEASE_TTL_SECONDS=5.0
LIFEGOODS_GENERATED_TRANSLATION_COOLDOWN_SECONDS=60
LIFEGOODS_GENERATED_TRANSLATION_BUDGET_PER_MINUTE=60
LIFEGOODS_GENERATED_TRANSLATION_POLL_INTERVAL_SECONDS=0.05

# Khmer Translation Provider (Google Gemini)
# Set your Gemini API key to enable live on-demand translation with gemini-3.8-flash.
# Both LIFEGOODS_GEMINI_API_KEY and GEMINI_API_KEY are supported.
# If unset/empty, new generation is disabled; compatible stored artifacts remain readable.
LIFEGOODS_GEMINI_API_KEY=
# Per-transport timeout cap in seconds; cannot extend the total translation-stage budget.
LIFEGOODS_GEMINI_TRANSLATION_TIMEOUT_SECONDS=12.0

# Open Food Facts Image Proxy & Rate Limiting
LIFEGOODS_OPEN_FOOD_FACTS_IMAGE_BASE_URL=https://images.openfoodfacts.org
LIFEGOODS_OPEN_FOOD_FACTS_IMAGE_TIMEOUT_SECONDS=2.0
LIFEGOODS_OPEN_FOOD_FACTS_USER_AGENT=LifeGoods/0.1.0 (https://github.com/internetOnion/life-goods)
LIFEGOODS_OPEN_FOOD_FACTS_IMAGE_REQUESTS_PER_MINUTE=60

# CORS Configuration (JSON-encoded array of allowed origins)
LIFEGOODS_ALLOWED_ORIGINS=["http://localhost:5173"]
