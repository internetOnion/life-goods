# PostgreSQL (System of Record for Catalog, Evidence, & Revisions)
LIFEGOODS_DATABASE_URL=postgresql+psycopg://lifegoods:lifegoods@localhost:5433/lifegoods

# CORS Configuration (JSON-encoded array of allowed origins)
LIFEGOODS_ALLOWED_ORIGINS=["http://localhost:5173"]

# Open Food Facts MongoDB Local Mirror
LIFEGOODS_OFF_MONGODB_URI=mongodb://lifegoods_reader:lifegoods_reader@localhost:27018/lifegoods_off
LIFEGOODS_OFF_MONGODB_DATABASE=lifegoods_off
LIFEGOODS_OFF_MONGODB_TIMEOUT_MS=2000

# Stateless Allergen Assessment Evaluation
# Requires an imported and manually activated FOOD_ALLERGEN Reference Dataset Version.
LIFEGOODS_ALLERGEN_ASSESSMENTS_ENABLED=false
LIFEGOODS_ASSESSMENT_ENGINE_VERSION=0.1.0

# Shared Package Match Rate Limiting & Non-Durable Assessment Cache (Redis)
# Shared limiting is the default. A Redis outage uses a bounded local fallback for five
# seconds, then probes the shared service again. Assessment caching remains optional.
LIFEGOODS_REDIS_URL=redis://localhost:6380/0
LIFEGOODS_REDIS_TIMEOUT_SECONDS=0.5
LIFEGOODS_PACKAGE_MATCH_REQUESTS_PER_MINUTE=60
LIFEGOODS_PACKAGE_MATCH_RATE_LIMIT_FALLBACK_SECONDS=5.0
LIFEGOODS_PACKAGE_MATCH_RATE_LIMIT_LOCAL_MAX_KEYS=10000
LIFEGOODS_ASSESSMENT_CACHE_ENABLED=true
LIFEGOODS_ASSESSMENT_CACHE_TTL_SECONDS=604800

# Open Food Facts Image Proxy & Rate Limiting
LIFEGOODS_OPEN_FOOD_FACTS_IMAGE_BASE_URL=https://images.openfoodfacts.org
LIFEGOODS_OPEN_FOOD_FACTS_IMAGE_TIMEOUT_SECONDS=2.0
LIFEGOODS_OPEN_FOOD_FACTS_USER_AGENT=LifeGoods/0.1.0 (https://github.com/internetOnion/life-goods)
LIFEGOODS_OPEN_FOOD_FACTS_IMAGE_REQUESTS_PER_MINUTE=60
